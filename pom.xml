<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>edu.scut.nqueens</groupId>
  <artifactId>nqueens-arch</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>N-Queens 五种软件体系结构风格实现</name>
  <description>《软件体系结构》作业1：用五种架构风格分别实现 N 皇后问题（N=8/10/12）</description>

  <properties>
    <!-- 编译目标：Java 21 LTS。本机 JDK 25 可直接编译 release 21 的代码 -->
    <maven.compiler.release>21</maven.compiler.release>
    <!-- 源文件含中文注释，必须显式声明 UTF-8，否则中文 Windows 下按 GBK 读取会编译报错 -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <junit.version>5.13.4</junit.version>
  </properties>

  <dependencies>
    <!-- 单元测试：用于验证「五种架构剪枝策略等价」等约束 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>

      <!-- 运行入口：mvn exec:java，具体参数见 README.md 的“运行”一节 -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <mainClass>edu.scut.nqueens.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
